{
  "name": "claimbuilder",
  "version": "1.0.0",
  "description": "ClaimBuilder - Fill PDF claim forms from templates using semantic field mappings. For encrypted templates, qpdf must be installed (e.g. brew install qpdf).",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:validation": "node --test tests/validation/**/*.test.js",
    "test:integration": "node --test tests/integration/**/*.test.js",
    "test:e2e": "node --test tests/e2e/**/*.test.js",
    "fill": "node src/fillForm.js",
    "list-fields": "node src/listFields.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
